# ── Unreal Engine ───────────────────────────────────────────────
# Regenerated by the engine on demand. Never commit these.
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Plugin build output (plugins themselves are versioned, their output is not)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ── Visual Studio / Rider / build tooling ───────────────────────
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# ── OS noise ────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Arcane / Claude Code ────────────────────────────────────────
# Slide decks shipped with the Arcane docs — binaries unrelated to the game.
.claude/docs/presentations/*.pptx
# Append-only session log; noise in diffs. active.md IS versioned.
production/session-state/*.log

# ── Explicitly versioned ────────────────────────────────────────
# Listed for the next person reading this file, not because git needs it:
#   *.uproject, Config/, Content/, Source/, Plugins/*/Source/, docs/
